{
	"$schema": "https://biomejs.dev/schemas/2.6.8/schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		"includes": ["resume/**", "!resume/images", "package.json"]
	},
	"formatter": {
		"enabled": true,
		"lineWidth": 100
	},
	"html": {
		"formatter": {
			"enabled": true
		}
	},
	"linter": {
		"enabled": true
	},
	"css": {
		"linter": {
			"enabled": true
		}
	},
	"assist": {
		"actions": {
			"source": {
				"organizeImports": "on"
			}
		}
	}
}
